# Copier ce fichier vers .env, puis adapter les valeurs.
# Ne jamais mettre de secret dans .env.example.

APP_NAME=FleetMind AI
APP_ENV=development

# Identifiants de démonstration des TMS simulés
MOCK_ALPHA_API_KEY=alpha-demo-key
MOCK_BETA_CLIENT_ID=fleetmind
MOCK_BETA_CLIENT_SECRET=beta-demo-secret

# Connexion PostgreSQL 18. Encoder les caractères spéciaux du mot de passe (ex. @ devient %40).
DATABASE_URL=postgresql+psycopg://UTILISATEUR:MOT_DE_PASSE@localhost:5432/fleetmind

# Surveillance automatique. En production, retirer les deux lignes de simulation.
MONITORING_ENABLED=true
# Démonstration : l'horloge démarre à cette heure et avance 10 fois plus vite.
MONITORING_SIMULATED_START=2026-11-07T11:00:00Z
MONITORING_TIME_SPEED=10

# LLM local (seuls les hôtes locaux ou privés sont acceptés)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=120
BUSINESS_TIMEZONE=Africa/Casablanca

# RAG : embeddings via Ollama et index local
EMBEDDING_MODEL=nomic-embed-text
QDRANT_PATH=data/qdrant
RAG_MIN_SCORE=0.65

# TMS Gamma simule : integration depuis sa documentation OpenAPI
MOCK_GAMMA_API_KEY=gamma-demo-token
